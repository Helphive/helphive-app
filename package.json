{
	"name": "helphive-frontend",
	"version": "1.0.1",
	"description": "Frontend mobile application in Expo for Helphive platform.",
	"main": "node_modules/expo/AppEntry.js",
	"author": "Maiz",
	"license": "UNLICENSED",
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"lint": "eslint src App.tsx --max-warnings 0",
		"format": "prettier --write .",
		"prepare": "husky .husky",
		"typecheck": "tsc --noEmit",
		"check": "npm run typecheck && npm run lint"
	},
	"dependencies": {
		"@cometchat/chat-sdk-react-native": "~4.0.12",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-community/datetimepicker": "9.1.0",
		"@react-navigation/bottom-tabs": "^7.22.0",
		"@react-navigation/native": "^7.5.2",
		"@react-navigation/stack": "^7.12.2",
		"@reduxjs/toolkit": "^2.5.0",
		"@stripe/stripe-react-native": "0.64.0",
		"babel-preset-expo": "~57.0.0",
		"dayjs": "^1.11.13",
		"expo": "~57.0.33",
		"expo-constants": "~57.0.24",
		"expo-dev-client": "~57.0.21",
		"expo-document-picker": "~57.0.3",
		"expo-file-system": "~57.0.7",
		"expo-font": "~57.0.4",
		"expo-image-picker": "~57.0.21",
		"expo-location": "~57.0.23",
		"expo-secure-store": "~57.0.4",
		"expo-splash-screen": "~57.0.11",
		"expo-status-bar": "~57.0.1",
		"onesignal-expo-plugin": "^2.8.1",
		"phosphor-react-native": "^3.0.6",
		"react": "19.2.3",
		"react-native": "0.86.3",
		"react-native-gesture-handler": "~2.32.0",
		"react-native-maps": "1.27.2",
		"react-native-onesignal": "^5.5.17",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.0",
		"react-native-svg": "15.15.4",
		"react-native-webview": "13.16.1",
		"react-redux": "^9.2.0"
	},
	"devDependencies": {
		"@babel/core": "^7.20.0",
		"@babel/preset-env": "^7.26.0",
		"@eslint/compat": "^1.2.3",
		"@eslint/js": "^9.15.0",
		"@types/node": "^22.1.0",
		"@types/react": "~19.2.10",
		"@typescript-eslint/eslint-plugin": "^8.14.0",
		"@typescript-eslint/parser": "^8.14.0",
		"eslint": "9.14.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-react": "^7.37.2",
		"eslint-plugin-react-hooks": "^5.0.0",
		"globals": "^15.8.0",
		"husky": "^9.0.11",
		"lint-staged": "^15.2.7",
		"prettier": "^3.3.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.14.0"
	},
	"engines": {
		"node": "22.12.0"
	},
	"lint-staged": {
		"**/*.{js,jsx,ts,tsx,json,css,md}": "prettier --write --end-of-line auto",
		"{src/**/*.{ts,tsx},App.tsx}": "eslint --max-warnings 0"
	},
	"expo": {
		"doctor": {
			"reactNativeDirectoryCheck": {
				"listUnknownPackages": false,
				"exclude": [
					"react-native-maps"
				]
			}
		}
	},
	"private": true
}
