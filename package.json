{
	"name": "helphive-frontend",
	"version": "1.0.1",
	"description": "Frontend mobile application in Expo for Helphive platform.",
	"main": "node_modules/expo/AppEntry.js",
	"author": "Maiz",
	"license": "UNLICENSED",
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"lint": "eslint src App.tsx --max-warnings 0",
		"format": "prettier --write .",
		"prepare": "husky .husky",
		"typecheck": "tsc --noEmit",
		"check": "npm run typecheck && npm run lint"
	},
	"dependencies": {
		"@cometchat/chat-sdk-react-native": "^4.0.12",
		"@react-native-async-storage/async-storage": "^2.1.0",
		"@react-native-community/datetimepicker": "^7.6.4",
		"@react-navigation/bottom-tabs": "^6.5.20",
		"@react-navigation/native": "^6.1.12",
		"@react-navigation/stack": "^6.4.1",
		"@reduxjs/toolkit": "^2.5.0",
		"@stripe/stripe-react-native": "0.38.6",
		"dayjs": "^1.11.13",
		"expo": "^52.0.21",
		"expo-dev-client": "^5.0.6",
		"expo-document-picker": "~13.0.1",
		"expo-file-system": "^18.0.6",
		"expo-font": "^13.0.2",
		"expo-image-picker": "~16.0.3",
		"expo-location": "^18.0.4",
		"expo-secure-store": "~14.0.0",
		"expo-splash-screen": "^0.29.18",
		"expo-status-bar": "~2.0.0",
		"expo-system-ui": "~4.0.9",
		"onesignal-expo-plugin": "^1.1.2",
		"phosphor-react-native": "^3.0.6",
		"react": "18.3.1",
		"react-native": "^0.76.5",
		"react-native-gesture-handler": "~2.20.2",
		"react-native-maps": "1.18.0",
		"react-native-onesignal": "^5.2.6",
		"react-native-safe-area-context": "4.12.0",
		"react-native-screens": "~4.1.0",
		"react-native-svg": "15.8.0",
		"react-native-webview": "^13.12.5",
		"react-redux": "^9.2.0"
	},
	"devDependencies": {
		"@babel/core": "^7.20.0",
		"@babel/preset-env": "^7.26.0",
		"@eslint/compat": "^1.2.3",
		"@eslint/js": "^9.15.0",
		"@types/node": "^22.1.0",
		"@types/react": "~18.3.12",
		"@typescript-eslint/eslint-plugin": "^8.14.0",
		"@typescript-eslint/parser": "^8.14.0",
		"eslint": "9.14.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-react": "^7.37.2",
		"eslint-plugin-react-hooks": "^5.0.0",
		"globals": "^15.8.0",
		"husky": "^9.0.11",
		"lint-staged": "^15.2.7",
		"prettier": "^3.3.3",
		"typescript": "^5.5.3",
		"typescript-eslint": "^8.14.0"
	},
	"engines": {
		"node": "22.12.0"
	},
	"lint-staged": {
		"**/*.{js,jsx,ts,tsx,json,css,md}": "prettier --write --end-of-line auto",
		"{src/**/*.{ts,tsx},App.tsx}": "eslint --max-warnings 0"
	},
	"expo": {
		"doctor": {
			"reactNativeDirectoryCheck": {
				"listUnknownPackages": false,
				"exclude": [
					"react-native-maps"
				]
			}
		}
	},
	"private": true
}
